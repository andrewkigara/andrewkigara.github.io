---
/**
 * The title-block footer: notes (or revisions) beside a 3×2 grid of cells.
 * Phone stacks the notes over a 2×3 grid that leads with the sheet number.
 */
interface Props {
  label: 'GENERAL NOTES' | 'REVISIONS';
  notes: string[];
  sheetNo: string;
  sheetTitle: string;
  scale: string;
  date: string;
}
const { label, notes, sheetNo, sheetTitle, scale, date } = Astro.props;
const List = label === 'REVISIONS' ? 'ul' : 'ol';
---
<footer class="tb">
  <div class="tb-notes">
    <h2 class="tb-label">{label}</h2>
    <List class:list={['tb-list', { 'tb-list--plain': List === 'ul' }]}>
      {notes.map((n) => <li>{n}</li>)}
    </List>
  </div>
  <dl class="tb-grid">
    <div class="tb-cell" data-cell="project"><dt>PROJECT</dt><dd>Personal site</dd></div>
    <div class="tb-cell" data-cell="drawn"><dt>DRAWN BY</dt><dd>A. Kigara</dd></div>
    <div class="tb-cell" data-cell="date"><dt>DATE</dt><dd><time>{date}</time></dd></div>
    <div class="tb-cell" data-cell="title"><dt>SHEET TITLE</dt><dd>{sheetTitle}</dd></div>
    <div class="tb-cell" data-cell="scale"><dt>SCALE</dt><dd>{scale}</dd></div>
    <div class="tb-cell" data-cell="no"><dt>SHEET NO.</dt><dd class="tb-no">{sheetNo}</dd></div>
  </dl>
</footer>

<style>
  .tb {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--l35);
    background: var(--bg);
  }
  .tb-notes {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px var(--side);
    border-bottom: 1px solid var(--l18);
  }
  .tb-label,
  dt {
    margin: 0;
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--muted);
  }
  .tb-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 18px;
    font-size: 12px;
    line-height: 1.5;
  }
  .tb-list--plain {
    padding-left: 0;
    list-style: none;
  }
  .tb-grid {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-areas: 'no title' 'date scale' 'project drawn';
    gap: 1px;
    background: var(--l18);
    background-clip: padding-box;
  }
  .tb-cell {
    padding: 10px 12px;
    background: var(--bg);
  }
  dt {
    margin-bottom: 4px;
    letter-spacing: 0.2em;
  }
  dd {
    margin: 0;
    font-size: 13px;
  }
  .tb-no {
    font-family: var(--font-display);
    font-size: 18px;
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  [data-cell='project'] { grid-area: project; }
  [data-cell='drawn'] { grid-area: drawn; }
  [data-cell='date'] { grid-area: date; }
  [data-cell='title'] { grid-area: title; }
  [data-cell='scale'] { grid-area: scale; }
  [data-cell='no'] { grid-area: no; }

  @media (min-width: 640px) {
    .tb-notes {
      gap: 8px;
      padding: 16px var(--side);
    }
    .tb-list {
      gap: 6px;
      padding-left: 20px;
      font-size: 13px;
    }
    .tb-list--plain {
      padding-left: 0;
    }
    .tb-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-areas: 'project drawn date' 'title scale no';
    }
    .tb-no {
      font-size: clamp(16px, 2vw, 24px);
    }
  }
  @media (min-width: 1024px) {
    .tb {
      display: flex;
      flex-wrap: wrap;
    }
    .tb-notes {
      flex: 999 1 380px;
      border-bottom: 0;
    }
    .tb-grid {
      flex: 1 1 520px;
      border-left: 1px solid var(--l35);
    }
  }
</style>
