---
import SheetIndex from '../components/SheetIndex.astro';
import SheetLayout from '../layouts/SheetLayout.astro';
---
<SheetLayout
  title="Index of Sheets · Andrew Kigara"
  description="Index of the five sheets in Andrew Kigara's drawing set: cover, profile, academic, side quests and album."
>
  <div class="page">
    <main id="main" tabindex="-1">
      <SheetIndex variant="page" />
    </main>
  </div>
</SheetLayout>

<style>
  .page {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: var(--page-pad);
  }
  main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  main:focus {
    outline: none;
  }
  main > :global(.si) {
    flex: 1;
    width: 100%;
  }
</style>
